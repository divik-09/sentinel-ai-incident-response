[
 {
  "id": "probe-pgbouncer",
  "tags": [
   "probe"
  ],
  "service": "api",
  "severity": "high",
  "title": "pgbouncer client queue growing",
  "summary": "Held-out case: pgbouncer client queue growing",
  "expected_root_cause": "database_connection_pool_exhaustion",
  "gold_evidence": [
   1,
   2,
   3
  ],
  "telemetry": [
   {
    "kind": "log",
    "service": "api",
    "payload": {
     "level": "ERROR",
     "code": "PGBOUNCER",
     "message": "no more connections allowed (max_client_conn)",
     "request_id": "req-pgbounce"
    }
   },
   {
    "kind": "metric",
    "service": "api",
    "payload": {
     "name": "pgbouncer_pools_cl_waiting",
     "value": 340,
     "unit": "count",
     "threshold": 10
    }
   },
   {
    "kind": "trace",
    "service": "api",
    "payload": {
     "trace_id": "tr-x",
     "span_id": "sp-x",
     "operation": "db.query",
     "duration_ms": 2800,
     "status": "ERROR",
     "attributes": {}
    }
   }
  ]
 },
