[
  {
    "id": "payment-pool-exhaustion",
    "title": "Checkout failures: payment database pool exhausted",
    "service": "payments",
    "severity": "critical",
    "summary": "Checkout requests are failing because payment workers cannot acquire database connections.",
    "expected_root_cause": "database_connection_pool_exhaustion",
    "expected_label": "Database connection pool exhaustion",
    "telemetry": [
      {"kind":"metric","service":"payments","payload":{"name":"http_5xx_rate","value":0.35,"unit":"ratio","threshold":0.05,"window":"5m"}},
      {"kind":"metric","service":"payments","payload":{"name":"db_pool_utilization","value":1.0,"unit":"ratio","threshold":0.85,"window":"5m"}},
      {"kind":"metric","service":"payments","payload":{"name":"request_p95_ms","value":2840,"unit":"ms","threshold":500,"window":"5m"}},
      {"kind":"log","service":"payments","payload":{"level":"ERROR","code":"DB_POOL_TIMEOUT","message":"Timed out waiting to acquire a database connection","request_id":"req-pay-1042"}},
      {"kind":"log","service":"payments","payload":{"level":"ERROR","code":"CHECKOUT_FAILED","message":"Payment authorization failed before transaction could begin","request_id":"req-pay-1043"}},
      {"kind":"trace","service":"payments","payload":{"trace_id":"tr-pay-001","span_id":"sp-001","operation":"POST /checkout","duration_ms":2921,"status":"ERROR","attributes":{"http.status_code":503}}},
      {"kind":"trace","service":"payments","payload":{"trace_id":"tr-pay-001","span_id":"sp-002","parent_span_id":"sp-001","operation":"db.acquire_connection","duration_ms":2204,"status":"ERROR","attributes":{"db.pool.wait_ms":2204}}},
      {"kind":"deployment","service":"payments","payload":{"version":"payments-2.4.1","commit":"a81f2d7","changes":"Reduced max database pool size from 20 to 4 during worker tuning","deployed_at":"2026-11-20T12:18:00Z"}}
    ]
  },
