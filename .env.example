# --- Core -------------------------------------------------------------------------------------
# development | test | staging | production. staging/production REFUSE to start without SENTINEL_API_KEYS.
SENTINEL_ENV=development
SENTINEL_DATABASE_PATH=./sentinel.db
SENTINEL_CORS_ORIGINS=http://localhost:8000
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_JSON=true

# --- Authentication / authorization ------------------------------------------------------------
# Generate entries with:  python scripts/create_api_key.py alice approver
# Format: name:role:sha256hex (comma-separated). Roles: viewer < operator < approver.
# Only hashes are configured on the server; keep raw keys in a secret manager.
SENTINEL_API_KEYS=
# api_key | disabled. Defaults to api_key when keys are configured. 'disabled' is rejected in staging/production.
# SENTINEL_AUTH_MODE=disabled
# The approver must differ from whoever created/investigated the incident. Default: on in staging/production.
# SENTINEL_FOUR_EYES=true
# Demo scenario launcher + /demo/* simulators. Default: on in development, off in staging/production.
# SENTINEL_ENABLE_DEMO=true

# --- Limits ------------------------------------------------------------------------------------
SENTINEL_RATE_LIMIT_PER_MINUTE=240
SENTINEL_MAX_BODY_BYTES=1048576

# --- Optional LLM modes (off by default; the system is fully functional without them) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Model chooses WHICH read-only tools to call. It never decides the diagnosis.
SENTINEL_ENABLE_LLM_AGENT=false
# Model writes an advisory second opinion that is display-only.
SENTINEL_ENABLE_MODEL_SYNTHESIS=false
